---
interface Props {
  title: string;
  activeNav: string;
  description?: string;
}

import SiteHead from "../components/SiteHead.astro";
import SiteIcon from "../components/SiteIcon.astro";
import AuroraBg from "../components/AuroraBg.astro";
import WaitlistDialog from "../components/WaitlistDialog.astro";

const { title, activeNav, description } = Astro.props;

const menuitems = [
  { title: "Home", path: "/" },
  { title: "Articoli", path: "/articoli" },
  { title: "Giochi", path: "/giochi" },
  { title: "Info", path: "/info" },
  { title: "Daimoku", path: "/daimoku" },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content={description ??
        "9, 10 e 11 ottobre 2026 si terrà a Marina di Camerota il corso autunnale del Territorio Salerno"}
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SiteHead />
    <meta name="theme-color" content="#7C3FA8" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline src="/registerSW.js"></script>
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    <AuroraBg />

    <header class="site-header">
      <nav class="nav-container" aria-label="Navigazione principale">
        <a class="brand" href="/">
          <SiteIcon width={32} height={32} class="brand-icon" />
          <span class="brand-text">
            Corso Salerno <span class="brand-year">2026</span>
          </span>
        </a>
        <ul class="nav-links nav-links--desktop">
          {
            menuitems.map((item) => (
              <li>
                <a
                  href={item.path}
                  class:list={[
                    "nav-link",
                    { active: activeNav === item.path },
                  ]}
                >
                  {item.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <nav class="mobile-nav" aria-label="Navigazione mobile">
      <ul class="mobile-nav-links">
        {
          menuitems.map((item) => (
            <li>
              <a
                href={item.path}
                class:list={[
                  "mobile-nav-link",
                  { active: activeNav === item.path },
                ]}
              >
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <slot />

    <footer class="site-footer">
      <a href="/2024/" class="archive-link">Archivio Corso 2024 →</a>
    </footer>

    <WaitlistDialog />
  </body>
</html>

<style is:global>
  :root {
    --rosa: #f9c8dc;
    --lavanda: #d8c9f0;
    --pesca: #fad9c1;
    --lilla: #e8d4f5;
    --viola: #7c3fa8;
    --viola-dark: #4a1f6e;
    --arancio: #e8823a;
    --testo: #1a1028;
    --testo-light: #5a4a72;
    --bianco: #ffffff;
    --card-bg: rgba(255, 255, 255, 0.82);

    --font-sans: "Inter", system-ui, sans-serif;
    --font-serif: "Playfair Display", Georgia, serif;

    --color-bg: #f7eef8;
    --color-surface: var(--card-bg);
    --color-text: var(--testo);
    --color-muted: var(--testo-light);
    --color-primary: var(--viola);
    --color-primary-dark: var(--viola-dark);
    --color-accent: var(--arancio);
    --color-border: rgba(124, 63, 168, 0.12);
    --gradient-primary: linear-gradient(135deg, var(--viola) 0%, var(--arancio) 100%);
    --shadow-sm: 0 4px 20px rgba(124, 63, 168, 0.08);
    --shadow-md: 0 8px 40px rgba(124, 63, 168, 0.12);
    --radius-sm: 12px;
    --radius-md: 20px;
    --nav-height: 60px;
    --mobile-nav-height: 3.75rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-sans);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
    padding-top: var(--nav-height);
    padding-bottom: var(--mobile-nav-height);
  }

  @media (min-width: 768px) {
    body {
      padding-bottom: 0;
    }
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(124, 63, 168, 0.1);
    height: var(--nav-height);
  }

  .nav-container {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 clamp(1.25rem, 4vw, 2rem);
  }

  @media (min-width: 768px) {
    .nav-container {
      justify-content: space-between;
    }
  }

  .brand {
    display: flex;
    text-decoration: none;
    align-items: center;
    gap: 0.55rem;
    flex-shrink: 0;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--viola-dark);
    letter-spacing: 0.01em;
  }

  .brand-icon {
    object-fit: contain;
    flex-shrink: 0;
  }

  .brand-text {
    display: inline;
    white-space: nowrap;
  }

  .brand-year {
    color: var(--arancio);
  }

  .nav-links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 1.35rem;
    margin: 0;
    padding: 0;
  }

  .nav-links--desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-links--desktop {
      display: flex;
    }
  }

  .nav-links li {
    display: flex;
    align-items: center;
  }

  .nav-link {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--testo-light);
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
    line-height: 1;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--viola);
    font-weight: 600;
  }

  .mobile-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--mobile-nav-height);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid rgba(124, 63, 168, 0.1);
  }

  @media (min-width: 768px) {
    .mobile-nav {
      display: none;
    }
  }

  .mobile-nav-links {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    height: 100%;
    margin: 0;
    padding: 0;
  }

  .mobile-nav-links li {
    display: flex;
    align-items: stretch;
  }

  .mobile-nav-link {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 0.64rem;
    font-weight: 600;
    color: var(--testo-light);
    text-decoration: none;
    padding: 0.5rem 0.15rem;
    transition: color 0.2s;
  }

  .mobile-nav-link.active {
    color: var(--viola);
  }

  .site-footer {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2.5rem 1.5rem calc(3rem + var(--mobile-nav-height));
    color: var(--testo-light);
    font-size: 0.9rem;
  }

  @media (min-width: 768px) {
    .site-footer {
      padding-bottom: 3rem;
    }
  }

  .archive-link {
    color: var(--viola);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
  }

  .archive-link:hover {
    text-decoration: underline;
  }

  .page {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) clamp(1.2rem, 4vw, 2rem) 4rem;
  }

  .page-wide {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) clamp(1.2rem, 4vw, 2rem) 4rem;
  }

  .page-icon {
    display: block;
    margin: 0 auto 1rem;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--viola-dark);
    margin-bottom: 1.25rem;
  }

  .section-lead {
    color: var(--testo-light);
    font-size: 1rem;
    margin: -0.5rem 0 1.5rem;
    line-height: 1.65;
  }

  .glass-card {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius-md);
    padding: clamp(1.5rem, 4vw, 2rem);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: var(--shadow-md);
    margin-bottom: 1.25rem;
  }

  .card {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius-md);
    padding: clamp(1.5rem, 4vw, 2rem);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: var(--shadow-sm);
    margin-bottom: 1.25rem;
  }

  .card-heading {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--viola-dark);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgba(124, 63, 168, 0.15);
  }

  .card-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.97rem;
    line-height: 1.6;
  }

  .card-list li::before {
    content: "→";
    color: var(--viola);
    font-weight: 700;
    flex-shrink: 0;
  }

  .cta-button {
    display: inline-block;
    padding: 0.75rem 1.6rem;
    background: var(--gradient-primary);
    color: white;
    text-decoration: none;
    font-weight: 600;
    border-radius: 100px;
    font-size: 0.9rem;
    box-shadow: 0 4px 16px rgba(124, 63, 168, 0.25);
    transition: transform 0.2s, box-shadow 0.2s;
    border: none;
    cursor: pointer;
    font-family: inherit;
    text-align: center;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(124, 63, 168, 0.32);
  }

  .cta-button-secondary {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: transparent;
    color: var(--viola);
    text-decoration: none;
    font-weight: 600;
    border-radius: 100px;
    font-size: 0.9rem;
    border: 1.5px solid rgba(124, 63, 168, 0.3);
    transition: background 0.2s, border-color 0.2s;
  }

  .cta-button-secondary:hover {
    background: rgba(124, 63, 168, 0.07);
    border-color: var(--viola);
  }

  /* Article body shared styles */
  .article-body {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: var(--radius-md);
    padding: clamp(1.8rem, 5vw, 3rem);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: var(--shadow-md);
  }

  .article-body p {
    font-size: 1.05rem;
    line-height: 1.82;
    color: var(--testo);
    margin-bottom: 1.5rem;
  }

  .article-body h2 {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--viola-dark);
    margin: 2.4rem 0 0.9rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgba(124, 63, 168, 0.15);
  }

  .article-intro {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--testo-light);
    font-style: italic;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(124, 63, 168, 0.12);
  }

  .article-figure {
    margin: 0 0 2rem;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(124, 63, 168, 0.12);
    box-shadow: 0 8px 32px rgba(124, 63, 168, 0.1);
  }

  .article-figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .scadenze {
    list-style: none;
    margin: 1.4rem 0 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .scadenza-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: linear-gradient(
      135deg,
      rgba(216, 201, 240, 0.3) 0%,
      rgba(249, 200, 220, 0.2) 100%
    );
    border: 1px solid rgba(124, 63, 168, 0.13);
    border-radius: 12px;
    padding: 1rem 1.2rem;
  }

  .scadenza-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .scadenza-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .scadenza-data {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--viola);
  }

  .scadenza-desc {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--testo);
  }

  .prep-list {
    list-style: none;
    margin: 1.2rem 0 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .prep-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .prep-icon {
    font-size: 1.4rem;
    flex-shrink: 0;
    margin-top: 0.05rem;
  }

  .prep-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .prep-label {
    font-weight: 600;
    font-size: 1rem;
    color: var(--viola-dark);
  }

  .prep-desc {
    font-size: 0.97rem;
    line-height: 1.65;
    color: var(--testo);
    margin-bottom: 0 !important;
  }

  .site-list {
    list-style: none;
    margin: 1rem 0 1.6rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem;
  }

  .site-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.97rem;
    color: var(--testo);
    line-height: 1.4;
  }

  .site-list li .s-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .whatsapp-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: linear-gradient(
      135deg,
      rgba(37, 211, 102, 0.08) 0%,
      rgba(37, 211, 102, 0.03) 100%
    );
    border: 1px solid rgba(37, 211, 102, 0.25);
    border-radius: 14px;
    padding: 1.2rem 1.4rem;
    margin: 1.6rem 0;
  }

  .whatsapp-card .wa-icon {
    font-size: 1.8rem;
    flex-shrink: 0;
  }

  .whatsapp-body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .whatsapp-card p {
    margin-bottom: 0 !important;
    font-size: 1rem !important;
  }

  .whatsapp-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    font-size: 0.88rem;
    font-weight: 600;
    color: #128c7e;
    text-decoration: none;
    padding: 0.55rem 1rem;
    border: 1.5px solid rgba(18, 140, 126, 0.35);
    border-radius: 100px;
    transition: background 0.2s, border-color 0.2s;
  }

  .whatsapp-link:hover {
    background: rgba(37, 211, 102, 0.1);
    border-color: #128c7e;
  }

  .firma {
    margin-top: 2.2rem;
    padding-top: 1.4rem;
    border-top: 1px solid rgba(124, 63, 168, 0.14);
    text-align: center;
  }

  .firma p {
    font-size: 0.95rem !important;
    color: var(--testo-light) !important;
    line-height: 1.7 !important;
    margin-bottom: 0 !important;
  }

  .firma strong {
    color: var(--viola-dark);
  }

  .end-mark {
    display: flex;
    justify-content: center;
    margin: 2.4rem 0 0;
    gap: 6px;
  }

  .end-mark span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--viola), var(--arancio));
    opacity: 0.5;
  }

  @media (max-width: 520px) {
    .site-list {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>
