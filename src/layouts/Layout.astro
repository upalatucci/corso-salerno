---
interface Props {
  title: string;
  activeNav: string;
}

const { title, activeNav } = Astro.props;

const menuitems = [
  {
    title: "Home",
    path: "/",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="1.4em" height="1.4em" viewBox="0 0 24 24"><path fill="currentColor" d="M10 20v-6h4v6h5v-8h3L12 3L2 12h3v8z"/></svg>`,
  },
  {
    title: "Info",
    path: "/info",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="1.4em" height="1.4em" viewBox="0 0 24 24"><path fill="currentColor" d="M13 9h-2V7h2m0 10h-2v-6h2m-1-9A10 10 0 0 0 2 12a10 10 0 0 0 10 10a10 10 0 0 0 10-10A10 10 0 0 0 12 2"/></svg>`,
  },
];
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="9, 10 e 11 ottobre 2026 si terrà a Marina di Camerota il corso autunnale del Territorio Salerno"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#8B5CF6" />
    <meta name="theme-color" content="#8B5CF6" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline src="/registerSW.js"></script>
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav-container">
        <a class="brand" href="/">
          <span class="brand-name">Corso Salerno</span>
          <span class="brand-year">2026</span>
        </a>
        <ul class="nav-links">
          {
            menuitems.map((item) => (
              <li>
                <a
                  href={item.path}
                  class={`nav-link ${activeNav === item.path ? "active" : ""}`}
                >
                  <span class="nav-icon" set:html={item.icon} />
                  <span class="nav-label">{item.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <a href="/2024/" class="archive-link">Archivio Corso 2024 →</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #fff9f5;
    --color-surface: #ffffff;
    --color-text: #1a1033;
    --color-muted: #6b6280;
    --color-primary: #8b5cf6;
    --color-primary-dark: #6d28d9;
    --color-accent: #ff6b6b;
    --color-accent-warm: #ffb347;
    --color-teal: #06d6a0;
    --color-border: rgba(139, 92, 246, 0.12);
    --gradient-primary: linear-gradient(135deg, #8b5cf6 0%, #ff6b6b 50%, #ffb347 100%);
    --gradient-hero: linear-gradient(
      160deg,
      #fff9f5 0%,
      #f3e8ff 35%,
      #ffe4e6 70%,
      #fff9f5 100%
    );
    --shadow-sm: 0 2px 8px rgba(139, 92, 246, 0.08);
    --shadow-md: 0 8px 32px rgba(139, 92, 246, 0.12);
    --radius-sm: 12px;
    --radius-md: 20px;
    --radius-lg: 28px;
    --nav-height: 4.5rem;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
    padding-bottom: calc(var(--nav-height) + 1rem);
  }

  @media (min-width: 768px) {
    body {
      padding-top: var(--nav-height);
      padding-bottom: 0;
    }
  }

  .site-header {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--color-border);
    height: var(--nav-height);
  }

  @media (min-width: 768px) {
    .site-header {
      top: 0;
      bottom: auto;
      border-top: none;
      border-bottom: 1px solid var(--color-border);
    }
  }

  .nav-container {
    max-width: 960px;
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
  }

  .brand {
    display: none;
    text-decoration: none;
    align-items: baseline;
    gap: 0.35rem;
  }

  @media (min-width: 768px) {
    .brand {
      display: flex;
    }
  }

  .brand-name {
    font-weight: 600;
    color: var(--color-text);
    font-size: 1.1rem;
  }

  .brand-year {
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-size: 1.1rem;
  }

  .nav-links {
    list-style: none;
    display: flex;
    width: 100%;
    justify-content: space-around;
  }

  @media (min-width: 768px) {
    .nav-links {
      width: auto;
      gap: 0.5rem;
    }
  }

  .nav-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    padding: 0.5rem 1rem;
    text-decoration: none;
    color: var(--color-muted);
    font-weight: 600;
    font-size: 0.75rem;
    border-radius: var(--radius-sm);
    transition: color 0.2s, background 0.2s;
  }

  @media (min-width: 768px) {
    .nav-link {
      flex-direction: row;
      font-size: 0.95rem;
      gap: 0.4rem;
    }
  }

  .nav-link.active {
    color: var(--color-primary);
  }

  .nav-link.active .nav-icon {
    color: var(--color-primary);
  }

  .nav-icon {
    display: flex;
    color: var(--color-muted);
  }

  .site-footer {
    text-align: center;
    padding: 2.5rem 1.5rem 1.5rem;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .archive-link {
    display: inline-block;
    margin-top: 0.75rem;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
  }

  .archive-link:hover {
    text-decoration: underline;
  }

  /* Shared page styles */
  .page-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .section {
    padding: 2.5rem 0;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .card {
    background: var(--color-surface);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    margin-bottom: 1rem;
  }

  .card-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
  }

  .card-list li::before {
    content: "→";
    color: var(--color-primary);
    font-weight: 700;
    flex-shrink: 0;
  }

  .badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 107, 107, 0.12);
    color: var(--color-accent);
    margin-left: 0.5rem;
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .price-row:last-child {
    border-bottom: none;
  }

  .price-amount {
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--color-primary);
  }

  .deadline-row {
    display: flex;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
    align-items: flex-start;
  }

  .deadline-row:last-child {
    border-bottom: none;
  }

  .deadline-date {
    font-weight: 800;
    color: var(--color-accent);
    white-space: nowrap;
    font-size: 0.9rem;
    min-width: 7.5rem;
  }

  .cta-button {
    display: inline-block;
    padding: 0.85rem 2rem;
    background: var(--gradient-primary);
    color: white;
    text-decoration: none;
    font-weight: 700;
    border-radius: 999px;
    font-size: 0.95rem;
    box-shadow: var(--shadow-md);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(139, 92, 246, 0.25);
  }
</style>
