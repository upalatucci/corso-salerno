---
import Layout from "../layouts/Layout.astro";
import { course2026 } from "../data/course2026";
---

<Layout title="Informazioni · Corso Salerno 2026" activeNav="/info">
  <main>
    <section class="info-header">
      <div class="page-container">
        <h1 class="info-title">Informazioni</h1>
        <p class="info-subtitle">
          Tutto quello che sappiamo finora sul corso autunnale 2026
        </p>
      </div>
    </section>

    <section class="section page-container">
      <div class="card">
        <h2 class="card-heading">Date e luogo</h2>
        <p class="info-detail">
          <strong>{course2026.dates}</strong><br />
          {course2026.location}
        </p>
        <p class="info-detail muted">{course2026.startNote}</p>
      </div>

      <div class="card">
        <h2 class="card-heading">Chi può partecipare</h2>
        <ul class="card-list">
          {
            course2026.participants.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </div>

      <div class="card">
        <h2 class="card-heading">Quote di partecipazione</h2>
        <p class="card-subtext">A persona</p>
        {
          course2026.pricing.map(({ room, price, limited }) => (
            <div class="price-row">
              <span>
                {room}
                {limited && <span class="badge">Disponibilità limitata</span>}
              </span>
              <span class="price-amount">€{price}</span>
            </div>
          ))
        }
        <p class="card-footnote">
          Le stanze singole, triple e quadruple hanno una disponibilità limitata.
        </p>
      </div>

      <div class="card">
        <h2 class="card-heading">Scadenze</h2>
        {
          course2026.deadlines.map(({ date, label }) => (
            <div class="deadline-row">
              <span class="deadline-date">Entro il {date}</span>
              <span>{label}</span>
            </div>
          ))
        }
      </div>

      <div class="card">
        <h2 class="card-heading">Bambini</h2>
        <ul class="card-list">
          {
            course2026.children.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </div>

      <div class="card coming-soon">
        <h2 class="card-heading">Prossimamente</h2>
        <p>
          Ulteriori informazioni, insieme alla scheda di adesione, arriveranno
          quanto prima. Resta sintonizzato!
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .info-header {
    padding: 2.5rem 0 0;
    text-align: center;
  }

  .info-title {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .info-subtitle {
    color: var(--color-muted);
    font-size: 1rem;
  }

  .info-detail {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .info-detail.muted {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .card-heading {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .card-subtext {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .card-footnote {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-top: 1rem;
    font-style: italic;
  }

  .coming-soon {
    background: linear-gradient(135deg, #f3e8ff, #ffe4e6);
    border: none;
    text-align: center;
  }

  .coming-soon p {
    font-weight: 500;
    color: var(--color-text);
  }

</style>
