---
import Layout from "../layouts/Layout.astro";
import SiteIcon from "../components/SiteIcon.astro";
import { course2026 } from "../data/course2026";
---

<Layout title="Informazioni · Corso Salerno 2026" activeNav="/info">
  <main class="page">
    <header class="page-header">
      <SiteIcon width={72} height={72} class="page-icon" />
      <h1 class="page-title">Informazioni</h1>
      <p class="page-subtitle">
        Corso autunnale del Territorio Salerno · 9–11 ottobre 2026
      </p>
    </header>

    <section>
      <div class="card">
        <h2 class="card-heading">Date e luogo</h2>
        <p class="info-detail">
          <strong>{course2026.dates}</strong><br />
          {course2026.locationAddress}
        </p>
        <p class="info-detail">
          <a
            href={course2026.locationWebsite}
            target="_blank"
            rel="noopener noreferrer"
            class="external-link"
          >
            {course2026.locationWebsite}
          </a>
        </p>
        <ul class="card-list">
          {
            course2026.schedule.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </div>

      <div class="card">
        <h2 class="card-heading">Chi può partecipare</h2>
        <ul class="card-list">
          {
            course2026.participants.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </div>

      <div class="card">
        <h2 class="card-heading">Costo del soggiorno per persona</h2>
        <p class="card-subtext">Il costo comprende:</p>
        <ul class="card-list included-list">
          {
            course2026.included.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
        {
          course2026.pricing.map(({ room, price, rooms, limited }) => (
            <div class="price-row">
              <span>
                {room}
                <span class="room-count">({rooms} camere disponibili)</span>
                {limited && <span class="badge">Disponibilità limitata</span>}
              </span>
              <span class="price-amount">€{price}</span>
            </div>
          ))
        }
      </div>

      <div class="card">
        <h2 class="card-heading">Bambini</h2>
        <ul class="card-list">
          {
            course2026.children.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </div>

      <div class="card" id="scadenze">
        <h2 class="card-heading">Scadenze pagamento</h2>
        <p class="card-subtext">
          La quota di iscrizione può essere versata in 2 rate oppure in un'unica
          soluzione entro il 31 luglio 2026.
        </p>
        {
          course2026.deadlines.map(({ date, label }) => (
            <div class="deadline-row">
              <span class="deadline-date">Entro il {date}</span>
              <span>{label}</span>
            </div>
          ))
        }
      </div>

      <div class="card">
        <h2 class="card-heading">Metodo di pagamento</h2>
        <div class="payment-block">
          <p class="payment-label">Bonifico bancario intestato a:</p>
          <p class="payment-detail"><strong>{course2026.payment.bankName}</strong></p>
          <p class="payment-detail">
            IBAN: <strong class="iban">{course2026.payment.iban}</strong>
          </p>
          <p class="payment-detail">Banca: {course2026.payment.bank}</p>
          <p class="payment-detail">
            Causale: <em>{course2026.payment.causale}</em>
          </p>
        </div>
        <ul class="card-list">
          {
            course2026.payment.otherMethods.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </div>

      <div class="card">
        <h2 class="card-heading">Penali</h2>
        <p class="card-subtext">
          In caso di rinuncia al corso senza possibilità di sostituzione:
        </p>
        <ul class="card-list">
          {
            course2026.penalties.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </div>

      <div class="card">
        <h2 class="card-heading">Contatti</h2>
        <div class="contact-block">
          <p class="contact-label">{course2026.contacts.committee.label}</p>
          <p class="contact-note">{course2026.contacts.committee.note}</p>
          <a href={`mailto:${course2026.contacts.committee.email}`} class="contact-link">
            {course2026.contacts.committee.email}
          </a>
        </div>
        <div class="contact-block">
          <p class="contact-label">{course2026.contacts.agency.label}</p>
          <p class="contact-detail">{course2026.contacts.agency.address}</p>
          <p class="contact-detail">
            Tel. <a href={`tel:${course2026.contacts.agency.phone}`}>{course2026.contacts.agency.phone}</a>
          </p>
          <a href={`mailto:${course2026.contacts.agency.email}`} class="contact-link">
            {course2026.contacts.agency.email}
          </a>
        </div>
      </div>

      <div class="card register-card">
        <h2 class="card-heading">Iscrizione</h2>
        <p>
          Compila la scheda di iscrizione online per registrarti al corso.
          Dopo la conferma riceverai una mail con il riepilogo dei dati e le
          informazioni per il pagamento.
        </p>
        <a
          href={course2026.registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-button register-button"
        >
          Iscriviti al corso
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 2.4rem);
    font-weight: 700;
    color: var(--viola-dark);
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    color: var(--testo-light);
    font-size: 1rem;
  }

  .info-detail {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .external-link {
    color: var(--viola);
    font-weight: 600;
    word-break: break-all;
  }

  .external-link:hover {
    text-decoration: underline;
  }

  .card-subtext {
    font-size: 0.9rem;
    color: var(--testo-light);
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .included-list {
    margin-bottom: 1rem;
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(124, 63, 168, 0.1);
  }

  .price-row:last-child {
    border-bottom: none;
  }

  .price-amount {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--viola);
  }

  .room-count {
    display: block;
    font-size: 0.8rem;
    color: var(--testo-light);
    font-weight: 400;
    margin-top: 0.15rem;
  }

  .badge {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 100px;
    background: rgba(232, 130, 58, 0.12);
    color: var(--arancio);
    margin-left: 0.4rem;
  }

  .deadline-row {
    display: flex;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(124, 63, 168, 0.1);
    align-items: flex-start;
  }

  .deadline-row:last-child {
    border-bottom: none;
  }

  .deadline-date {
    font-weight: 700;
    color: var(--viola);
    white-space: nowrap;
    font-size: 0.88rem;
    min-width: 7.5rem;
  }

  .payment-block {
    margin-bottom: 1rem;
  }

  .payment-label {
    font-size: 0.9rem;
    color: var(--testo-light);
    margin-bottom: 0.5rem;
  }

  .payment-detail {
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
    line-height: 1.5;
  }

  .iban {
    font-family: monospace;
    letter-spacing: 0.03em;
  }

  .contact-block {
    margin-bottom: 1.25rem;
  }

  .contact-block:last-child {
    margin-bottom: 0;
  }

  .contact-label {
    font-weight: 600;
    color: var(--viola-dark);
    margin-bottom: 0.25rem;
  }

  .contact-note {
    font-size: 0.85rem;
    color: var(--testo-light);
    margin-bottom: 0.35rem;
  }

  .contact-detail {
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .contact-link {
    color: var(--viola);
    font-weight: 600;
    text-decoration: none;
  }

  .contact-link:hover {
    text-decoration: underline;
  }

  .register-card {
    background: linear-gradient(
      135deg,
      rgba(216, 201, 240, 0.4) 0%,
      rgba(249, 200, 220, 0.3) 100%
    );
    text-align: center;
  }

  .register-card p {
    font-weight: 500;
    color: var(--testo);
    margin-bottom: 1.25rem;
    line-height: 1.6;
  }

  .register-button {
    margin-top: 0.5rem;
  }
</style>
