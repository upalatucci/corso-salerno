---
import Layout from "../layouts/Layout.astro";
import Countdown2026 from "../components/Countdown2026.astro";
import SiteIcon from "../components/SiteIcon.astro";
import { course2026 } from "../data/course2026";
import { articles } from "../data/articles";

const minPrice = Math.min(...course2026.pricing.map(({ price }) => price));
const nextDeadline = course2026.deadlines[0];
const latestArticle = articles[0];
---

<Layout title="Corso Salerno 2026" activeNav="/">
  <main>
    <section class="hero page-wide">
      <div class="hero-content">
        <div class="hero-logo-wrap">
          <SiteIcon width={200} height={200} class="hero-logo" />
        </div>
        <p class="hero-eyebrow">Corso autunnale del Territorio Salerno</p>
        <h1 class="hero-title">
          Salerno <span class="hero-year">2026</span>
        </h1>
        <p class="hero-dates">{course2026.dates}</p>
        <p class="hero-location">{course2026.location}</p>

        <div class="hero-facts">
          <span class="fact-chip">Happy Village · Camerota</span>
          <span class="fact-chip">da €{minPrice} a persona</span>
        </div>

        <div class="hero-countdown">
          <Countdown2026 />
        </div>

        <div class="hero-actions">
          <a
            href={course2026.registrationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-button"
          >
            Iscriviti al corso
          </a>
          <div class="hero-actions-row">
            <a href="/articoli" class="cta-button-secondary">Leggi gli articoli</a>
            <a href="/giochi" class="cta-button-secondary">Giochi</a>
            <a href="/daimoku" class="cta-button-secondary">Conta Daimoku</a>
          </div>
        </div>
      </div>
    </section>

    {
      latestArticle && (
        <section class="page-wide home-section">
          <h2 class="section-title">Ultimo articolo</h2>
          <a href={`/articoli/${latestArticle.slug}`} class="featured-article">
            <span class="featured-eyebrow">{latestArticle.eyebrow}</span>
            <h3 class="featured-title">{latestArticle.title}</h3>
            <p class="featured-excerpt">{latestArticle.excerpt}</p>
            <span class="featured-link">Leggi l'articolo →</span>
          </a>
        </section>
      )
    }

    <section class="page-wide home-section" id="materiali-studio">
      <h2 class="section-title">Materiali di studio</h2>
      <p class="section-lead">
        Inizia a prepararti: ecco i testi che approfondiremo durante il corso.
      </p>

      <div class="study-cards">
        {
          course2026.studyMaterials.map((material) => (
            <article class="study-card">
              <span class="study-card-icon">
                {material.type === "gosho" ? "📜" : "📖"}
              </span>
              <h3 class="study-card-title">{material.title}</h3>
              {"chapter" in material && material.chapter && (
                <p class="study-card-chapter">
                  Capitolo: <em>{material.chapter}</em>
                </p>
              )}
              <p class="study-card-desc">{material.description}</p>
              <div class="study-card-links">
                {material.links.map((link) => (
                  <a
                    href={link.href}
                    target={link.href.startsWith("http") ? "_blank" : undefined}
                    rel={
                      link.href.startsWith("http")
                        ? "noopener noreferrer"
                        : undefined
                    }
                    class="study-card-link"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <p class="study-more">
        <a href="/info#materiali-studio">Tutti i dettagli →</a>
        ·
        <a href="/giochi">Metti alla prova lo studio →</a>
      </p>
    </section>

    <section class="page-wide home-section" id="giochi">
      <h2 class="section-title">Giochi</h2>
      <p class="section-lead">
        Quiz e ruota delle esperienze per accendere la curiosità sui testi del
        corso — e arrivare a ottobre già in accelerazione.
      </p>
      <div class="games-teasers">
        <a href="/giochi/quiz" class="games-teaser">
          <span class="games-teaser-kicker">Studio giocando</span>
          <strong class="games-teaser-title">Quiz</strong>
          <span class="games-teaser-desc">Gosho e capitolo Accelerazione</span>
        </a>
        <a href="/giochi/ruota" class="games-teaser">
          <span class="games-teaser-kicker">Sfide verso il 9 ottobre</span>
          <strong class="games-teaser-title">Ruota delle esperienze</strong>
          <span class="games-teaser-desc">Pesca una sfida e arriva incoraggiato</span>
        </a>
      </div>
      <p class="study-more">
        <a href="/giochi">Vai ai giochi →</a>
      </p>
    </section>

    <section class="page-wide home-section">
      <h2 class="section-title">Cosa ti serve</h2>
      <p class="section-lead">
        Tutto quello che serve per prepararsi al corso, in un colpo d'occhio.
      </p>

      <div class="quick-links">
        <a href={course2026.registrationUrl} target="_blank" rel="noopener noreferrer" class="quick-link">
          <span class="quick-icon">✓</span>
          <span class="quick-body">
            <span class="quick-title">Iscriviti al corso</span>
            <span class="quick-desc">Compila la scheda online</span>
          </span>
        </a>
        <a href="/articoli" class="quick-link">
          <span class="quick-icon">📰</span>
          <span class="quick-body">
            <span class="quick-title">Articoli</span>
            <span class="quick-desc">Notizie e aggiornamenti</span>
          </span>
        </a>
        <a
          href={course2026.whatsappChannelUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="quick-link"
        >
          <span class="quick-icon">💬</span>
          <span class="quick-body">
            <span class="quick-title">Canale WhatsApp</span>
            <span class="quick-desc">Novità e aggiornamenti</span>
          </span>
        </a>
        <a href="/info" class="quick-link">
          <span class="quick-icon">ℹ️</span>
          <span class="quick-body">
            <span class="quick-title">Info e quote</span>
            <span class="quick-desc">Date, costi e contatti</span>
          </span>
        </a>
        <a href="#materiali-studio" class="quick-link">
          <span class="quick-icon">📖</span>
          <span class="quick-body">
            <span class="quick-title">Materiali di studio</span>
            <span class="quick-desc">Gosho e Nuova Rivoluzione Umana</span>
          </span>
        </a>
        <a href="/giochi" class="quick-link">
          <span class="quick-icon">🎯</span>
          <span class="quick-body">
            <span class="quick-title">Giochi</span>
            <span class="quick-desc">Quiz e ruota delle esperienze</span>
          </span>
        </a>
        <a href="/daimoku" class="quick-link">
          <span class="quick-icon">📿</span>
          <span class="quick-body">
            <span class="quick-title">Conta Daimoku</span>
            <span class="quick-desc">Contatore condiviso</span>
          </span>
        </a>
      </div>

      <div class="deadline-banner">
        <div class="deadline-content">
          <p class="deadline-label">Prossima scadenza</p>
          <p class="deadline-text">
            <strong>Entro il {nextDeadline.date}</strong> — {nextDeadline.label}
          </p>
        </div>
        <a href="/info#scadenze" class="deadline-link">Dettagli →</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    text-align: center;
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  .hero-content {
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-logo-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .hero-logo {
    width: min(200px, 50vw);
    height: auto;
  }

  .hero-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--viola);
    margin-bottom: 0.75rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 700;
    color: var(--viola-dark);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .hero-year {
    color: var(--arancio);
  }

  .hero-dates {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--testo);
    margin-bottom: 0.3rem;
  }

  .hero-location {
    font-size: 0.97rem;
    color: var(--testo-light);
    margin-bottom: 1.25rem;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .fact-chip {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(124, 63, 168, 0.12);
    color: var(--testo-light);
  }

  .hero-countdown {
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .hero-actions-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .home-section {
    padding-top: 0;
    padding-bottom: 3rem;
  }

  .featured-article {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border-radius: var(--radius-md);
    padding: 1.6rem 1.8rem;
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s, box-shadow 0.2s;
    margin-bottom: 0.5rem;
  }

  .featured-article:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .featured-eyebrow {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--viola);
    margin-bottom: 0.5rem;
  }

  .featured-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--viola-dark);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .featured-excerpt {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--testo-light);
    margin-bottom: 0.75rem;
  }

  .featured-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--viola);
  }

  .quick-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 600px) {
    .quick-links {
      grid-template-columns: 1fr 1fr;
    }
  }

  .quick-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .quick-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .quick-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(124, 63, 168, 0.1);
    border-radius: 10px;
  }

  .quick-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: left;
  }

  .quick-title {
    font-weight: 600;
    font-size: 0.97rem;
    color: var(--viola-dark);
  }

  .quick-desc {
    font-size: 0.82rem;
    color: var(--testo-light);
  }

  .deadline-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.35rem;
    background: linear-gradient(
      135deg,
      rgba(216, 201, 240, 0.35) 0%,
      rgba(249, 200, 220, 0.25) 100%
    );
    border-radius: var(--radius-md);
    border: 1px solid rgba(124, 63, 168, 0.13);
  }

  .deadline-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--viola);
    margin-bottom: 0.2rem;
  }

  .deadline-text {
    font-size: 0.9rem;
    color: var(--testo);
    line-height: 1.45;
  }

  .deadline-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--viola);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .deadline-link:hover {
    text-decoration: underline;
  }

  .study-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 640px) {
    .study-cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  .study-card {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border-radius: var(--radius-md);
    padding: 1.4rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: var(--shadow-sm);
  }

  .study-card-icon {
    display: block;
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .study-card-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--viola-dark);
    line-height: 1.35;
    margin-bottom: 0.35rem;
  }

  .study-card-chapter {
    font-size: 0.88rem;
    color: var(--testo-light);
    margin-bottom: 0.5rem;
  }

  .study-card-desc {
    font-size: 0.9rem;
    color: var(--testo-light);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .study-card-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .study-card-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--viola);
    text-decoration: none;
  }

  .study-card-link:hover {
    text-decoration: underline;
  }

  .study-more {
    text-align: center;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .study-more a {
    color: var(--viola);
    text-decoration: none;
  }

  .study-more a:hover {
    text-decoration: underline;
  }

  .games-teasers {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 600px) {
    .games-teasers {
      grid-template-columns: 1fr 1fr;
    }
  }

  .games-teaser {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border-radius: var(--radius-md);
    padding: 1.3rem 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .games-teaser:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .games-teaser-kicker {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--viola);
    margin-bottom: 0.4rem;
  }

  .games-teaser-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--viola-dark);
    margin-bottom: 0.3rem;
  }

  .games-teaser-desc {
    font-size: 0.9rem;
    color: var(--testo-light);
    line-height: 1.5;
  }
</style>
