---
import Layout from "../layouts/Layout.astro";
import SiteIcon from "../components/SiteIcon.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";

const manifestPath = join(process.cwd(), "src/data/gallery.json");
let galleryItems: { src: string; thumb: string; alt: string }[] = [];

if (existsSync(manifestPath)) {
  galleryItems = JSON.parse(readFileSync(manifestPath, "utf8"));
}
---

<Layout
  title="Corso Salerno 2026 — Ricordi"
  activeNav="/"
  description="Galleria fotografica e ricordi del Corso Autunnale del Territorio Salerno, 9–11 ottobre 2026 a Marina di Camerota."
>
  <main>
    <section class="hero page-wide">
      <div class="hero-content">
        <div class="hero-logo-wrap">
          <SiteIcon width={200} height={200} class="hero-logo" />
        </div>
        <p class="hero-eyebrow">Grazie a tutti</p>
        <h1 class="hero-title">
          Un corso da <span class="hero-accent">ricordare</span>
        </h1>
        <p class="hero-dates">9, 10 e 11 ottobre 2026</p>
        <p class="hero-location">Happy Village · Marina di Camerota</p>
        <p class="hero-lead">
          Tre giorni di studio, amicizia e sole sul Cilento. Qui trovi le foto del
          corso: rivivi i momenti più belli e condividile con chi c’era con noi.
        </p>

        <div class="hero-facts">
          <span class="fact-chip">Corso concluso</span>
          {
            galleryItems.length > 0 && (
              <span class="fact-chip">{galleryItems.length} foto</span>
            )
          }
        </div>

        <div class="hero-actions">
          {
            galleryItems.length > 0 && (
              <a href="#galleria" class="cta-button">Vai alla galleria</a>
            )
          }
          <div class="hero-actions-row">
            <a href="/articoli" class="cta-button-secondary">Articoli</a>
            <a href="/daimoku" class="cta-button-secondary">Conta Daimoku</a>
            <a href="/giochi" class="cta-button-secondary">Giochi</a>
          </div>
        </div>
      </div>
    </section>

    {
      galleryItems.length > 0 ? (
        <div class="page-wide">
          <PhotoGallery items={galleryItems} />
        </div>
      ) : (
        <section class="page-wide home-section">
          <p class="section-lead gallery-missing">
            La galleria non è ancora pronta. Esegui <code>npm run gallery:build</code> per
            importare le foto.
          </p>
        </section>
      )
    }

    <section class="page-wide home-section home-links">
      <h2 class="section-title">Resta in contatto</h2>
      <p class="section-lead">
        Materiali, articoli e strumenti del corso restano disponibili sul sito.
      </p>
      <div class="link-cards">
        <a href="/articoli" class="link-card">
          <span class="link-card-icon" aria-hidden="true">📰</span>
          <span class="link-card-body">
            <strong>Articoli</strong>
            <span>Notizie e video dal corso</span>
          </span>
        </a>
        <a href="/info" class="link-card">
          <span class="link-card-icon" aria-hidden="true">ℹ️</span>
          <span class="link-card-body">
            <strong>Info</strong>
            <span>Riferimenti e contatti</span>
          </span>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    text-align: center;
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .hero-content {
    max-width: 640px;
    margin: 0 auto;
  }

  .hero-logo-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .hero-logo {
    width: min(200px, 50vw);
    height: auto;
  }

  .hero-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--viola);
    margin-bottom: 0.75rem;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 7vw, 3.5rem);
    font-weight: 700;
    color: var(--viola-dark);
    line-height: 1.12;
    margin-bottom: 0.75rem;
  }

  .hero-accent {
    color: var(--arancio);
  }

  .hero-dates {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--testo);
    margin-bottom: 0.3rem;
  }

  .hero-location {
    font-size: 0.97rem;
    color: var(--testo-light);
    margin-bottom: 0.75rem;
  }

  .hero-lead {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--testo-light);
    margin-bottom: 1.25rem;
    max-width: 36rem;
    margin-inline: auto;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .fact-chip {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.35rem 0.85rem;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(124, 63, 168, 0.12);
    color: var(--testo-light);
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .hero-actions-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .home-section {
    padding-top: 0;
    padding-bottom: 3rem;
  }

  .gallery-missing {
    text-align: center;
  }

  .gallery-missing code {
    font-size: 0.88em;
    padding: 0.15rem 0.4rem;
    border-radius: 6px;
    background: rgba(124, 63, 168, 0.08);
  }

  .home-links {
    padding-top: 1rem;
  }

  .link-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }

  @media (min-width: 560px) {
    .link-cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  .link-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .link-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .link-card-icon {
    font-size: 1.35rem;
    flex-shrink: 0;
  }

  .link-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: left;
  }

  .link-card-body strong {
    font-size: 0.97rem;
    color: var(--viola-dark);
  }

  .link-card-body span:last-child {
    font-size: 0.82rem;
    color: var(--testo-light);
  }
</style>
