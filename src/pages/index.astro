---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Welcome to Astro.">
  <main>
    <div class="hero">
      <h1>Corso del territorio Salerno</h1>
      <p>Dal 27 al 29 Settembre</p>
      <p class="lead">
        Use this document as a way to quickly start any new project.<br /> All you
        get is this text and a mostly barebones HTML document.
      </p>
      <button class="btn btn-primary" type="button"
        >Aggiungi il tuo Daimoku</button
      >
    </div>
  </main>
</Layout>

<style>
  .hero {
    padding: 3rem 1.5rem;
    text-align: center;
  }
</style>
