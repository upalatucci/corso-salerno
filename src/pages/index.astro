---
import Layout from "../layouts/Layout.astro";
import Countdown2026 from "../components/Countdown2026.astro";
import { course2026 } from "../data/course2026";
---

<Layout title="Corso Salerno 2026" activeNav="/">
  <main>
    <section class="hero">
      <div class="hero-bg"></div>
      <div class="page-container hero-content">
        <p class="hero-eyebrow">Corso autunnale del Territorio Salerno</p>
        <h1 class="hero-title">
          <span class="hero-title-main">Salerno</span>
          <span class="hero-title-year">2026</span>
        </h1>
        <p class="hero-dates">{course2026.dates}</p>
        <p class="hero-location">{course2026.location}</p>
        <p class="hero-note">{course2026.startNote}</p>

        <div class="hero-countdown">
          <Countdown2026 />
        </div>

        <a href="/info" class="cta-button">Scopri tutte le info</a>
      </div>
    </section>

    <section class="section page-container">
      <h2 class="section-title">Primi spoiler</h2>

      <div class="card">
        <h3 class="card-heading">Chi può partecipare</h3>
        <ul class="card-list">
          {
            course2026.participants.map((item) => (
              <li>{item}</li>
            ))
          }
        </ul>
      </div>

      <div class="card">
        <h3 class="card-heading">Quote di partecipazione</h3>
        <p class="card-subtext">A persona · stanze singole, triple e quadruple in disponibilità limitata</p>
        {
          course2026.pricing.map(({ room, price, limited }) => (
            <div class="price-row">
              <span>
                {room}
                {limited && <span class="badge">Limitata</span>}
              </span>
              <span class="price-amount">€{price}</span>
            </div>
          ))
        }
      </div>

      <div class="card highlight-card">
        <p class="highlight-text">
          La scheda di iscrizione online arriverà a stretto giro — stay tuned!
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    position: relative;
    padding: 3rem 0 2.5rem;
    overflow: hidden;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: var(--gradient-hero);
    z-index: 0;
  }

  .hero-bg::before,
  .hero-bg::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.5;
  }

  .hero-bg::before {
    width: 300px;
    height: 300px;
    background: #c4b5fd;
    top: -80px;
    right: -60px;
  }

  .hero-bg::after {
    width: 250px;
    height: 250px;
    background: #fca5a5;
    bottom: -40px;
    left: -40px;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .hero-title-main {
    font-size: clamp(3rem, 12vw, 5.5rem);
    font-weight: 800;
    color: var(--color-text);
  }

  .hero-title-year {
    font-size: clamp(4rem, 16vw, 7rem);
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-dates {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }

  .hero-location {
    font-size: 1rem;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
  }

  .hero-note {
    font-size: 0.9rem;
    color: var(--color-muted);
    max-width: 28rem;
    margin: 0 auto 2rem;
    line-height: 1.5;
  }

  .hero-countdown {
    margin-bottom: 2rem;
  }

  .card-heading {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .card-subtext {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }

  .highlight-card {
    background: linear-gradient(135deg, #f3e8ff, #ffe4e6);
    border: none;
    text-align: center;
  }

  .highlight-text {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text);
  }

</style>
