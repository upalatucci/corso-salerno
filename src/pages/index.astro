---
import Layout from "../layouts/Layout.astro";
import Countdown2026 from "../components/Countdown2026.astro";
import { course2026 } from "../data/course2026";

const minPrice = Math.min(...course2026.pricing.map(({ price }) => price));
const nextDeadline = course2026.deadlines[0];

const actionCards = [
  {
    title: "Iscriviti al corso",
    description: "Compila la scheda online per prenotare il tuo posto.",
    href: course2026.registrationUrl,
    external: true,
    variant: "primary",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 24 24"><path fill="currentColor" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2m-7 14l-5-5l1.41-1.41L12 14.17l7.59-7.59L21 8z"/></svg>`,
  },
  {
    title: "Info e quote",
    description: "Date, costi, pagamenti, penali e contatti utili.",
    href: "/info",
    external: false,
    variant: "default",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 24 24"><path fill="currentColor" d="M13 9h-2V7h2m0 10h-2v-6h2m-1-9A10 10 0 0 0 2 12a10 10 0 0 0 10 10a10 10 0 0 0 10-10A10 10 0 0 0 12 2"/></svg>`,
  },
  {
    title: "Conta Daimoku",
    description: "Conta il tuo Daimoku e vedi chi sta recitando ora.",
    href: "/daimoku",
    external: false,
    variant: "green",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 24 24"><path fill="currentColor" d="M12 22a1 1 0 0 1-1-1v-3H8.5a2.5 2.5 0 0 1 0-5H11v-2H8.5a2.5 2.5 0 0 1 0-5H11V4a1 1 0 1 1 2 0v3h2.5a2.5 2.5 0 0 1 0 5H13v2h2.5a2.5 2.5 0 0 1 0 5H13v3a1 1 0 0 1-1 1"/></svg>`,
  },
];
---

<Layout title="Corso Salerno 2026" activeNav="/">
  <main>
    <section class="hero">
      <div class="hero-bg"></div>
      <div class="page-container hero-content">
        <p class="hero-eyebrow">Corso autunnale del Territorio Salerno</p>
        <h1 class="hero-title">
          <span class="hero-title-main">Salerno</span>
          <span class="hero-title-year">2026</span>
        </h1>
        <p class="hero-dates">{course2026.dates}</p>
        <p class="hero-location">{course2026.location}</p>

        <div class="hero-facts">
          <span class="fact-chip">Happy Village · Camerota</span>
          <span class="fact-chip">da €{minPrice} a persona</span>
        </div>

        <div class="hero-countdown">
          <Countdown2026 />
        </div>

        <div class="hero-actions">
          <a
            href={course2026.registrationUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-button"
          >
            Iscriviti al corso
          </a>
          <div class="hero-actions-row">
            <a href="/daimoku" class="cta-button-daimoku">Conta Daimoku</a>
            <a href="/info" class="cta-button-secondary">Tutte le info</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section page-container">
      <h2 class="section-title">Cosa ti serve</h2>
      <p class="section-lead">
        Tutto quello che serve per prepararsi al corso, in un colpo d'occhio.
      </p>

      <div class="action-grid">
        {
          actionCards.map(
            ({ title, description, href, external, variant, icon }) => (
              <a
                href={href}
                class={`action-card action-card--${variant}`}
                {...(external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                <span class="action-icon" set:html={icon} />
                <span class="action-body">
                  <span class="action-title">{title}</span>
                  <span class="action-desc">{description}</span>
                </span>
                <span class="action-arrow" aria-hidden="true">→</span>
              </a>
            ),
          )
        }
      </div>

      <div class="deadline-banner">
        <div class="deadline-content">
          <p class="deadline-label">Prossima scadenza</p>
          <p class="deadline-text">
            <strong>Entro il {nextDeadline.date}</strong> — {nextDeadline.label}
          </p>
        </div>
        <a href="/info#scadenze" class="deadline-link">Dettagli →</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    position: relative;
    padding: 3rem 0 2.5rem;
    overflow: hidden;
    min-height: 72vh;
    display: flex;
    align-items: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: var(--gradient-hero);
    z-index: 0;
  }

  .hero-bg::before,
  .hero-bg::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.5;
  }

  .hero-bg::before {
    width: 300px;
    height: 300px;
    background: #c4b5fd;
    top: -80px;
    right: -60px;
  }

  .hero-bg::after {
    width: 250px;
    height: 250px;
    background: #fca5a5;
    bottom: -40px;
    left: -40px;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero-eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .hero-title-main {
    font-size: clamp(3rem, 12vw, 5.5rem);
    font-weight: 800;
    color: var(--color-text);
  }

  .hero-title-year {
    font-size: clamp(4rem, 16vw, 7rem);
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-dates {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }

  .hero-location {
    font-size: 1rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .fact-chip {
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .hero-countdown {
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-actions-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .cta-button-secondary {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    background: transparent;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 700;
    border-radius: 999px;
    font-size: 0.95rem;
    border: 2px solid var(--color-primary);
    transition: background 0.2s, color 0.2s;
  }

  .cta-button-secondary:hover {
    background: var(--color-primary);
    color: white;
  }

  .cta-button-daimoku {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    background: #059669;
    color: white;
    text-decoration: none;
    font-weight: 700;
    border-radius: 999px;
    font-size: 0.95rem;
    box-shadow: 0 8px 32px rgba(5, 150, 105, 0.25);
    transition: transform 0.2s, background 0.2s;
  }

  .cta-button-daimoku:hover {
    transform: translateY(-2px);
    background: #047857;
  }

  .section-lead {
    color: var(--color-muted);
    font-size: 1rem;
    margin: -0.75rem 0 1.5rem;
    line-height: 1.6;
  }

  .action-grid {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .action-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.35rem;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .action-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: rgba(139, 92, 246, 0.25);
  }

  .action-card--primary {
    background: linear-gradient(135deg, #f3e8ff, #ffe4e6);
    border-color: rgba(139, 92, 246, 0.2);
  }

  .action-card--green {
    background: linear-gradient(135deg, #ecfdf5, #f0fdf4);
    border-color: rgba(5, 150, 105, 0.2);
  }

  .action-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    background: rgba(139, 92, 246, 0.1);
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .action-card--green .action-icon {
    background: rgba(5, 150, 105, 0.12);
    color: #059669;
  }

  .action-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: left;
  }

  .action-title {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-text);
  }

  .action-desc {
    font-size: 0.85rem;
    color: var(--color-muted);
    line-height: 1.45;
  }

  .action-arrow {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .action-card--green .action-arrow {
    color: #059669;
  }

  .deadline-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.35rem;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
  }

  .deadline-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: 0.2rem;
  }

  .deadline-text {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.45;
  }

  .deadline-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .deadline-link:hover {
    text-decoration: underline;
  }

  @media (min-width: 640px) {
    .action-grid {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
