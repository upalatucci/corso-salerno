---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Materiale">
  <main>
    <div class="row justify-content-center">
      <div class="hero col-12 col-md-8 col-lg-5">
        <h1>Contattaci</h1>
        <p>
          Hai desiderio di esprimere le tue idee o considerazioni? O
          semplicemente vuoi maggiori informazioni? Contattaci
        </p>
      </div>
    </div>
  </main>

  <style>
    .hero {
      padding: 3rem 1.5rem;
      text-align: center;
    }
  </style>
</Layout>
