---
import Goals from "../components/Goals.astro";
import Layout from "../layouts/Layout.astro";

const goals = [
  "Basare e dedicare la mia vita a kosen rufu, per incoraggiare quante più giovani possibili. Decidere di vincere, senza alcun dubbio.",
  "Realizzare grande unità e fiducia nell'ambito della mia attività, vedere emergere tanti giovani che si assumono la responsabilità di kosen rufu. \nRealizzare un grande obiettivo economico ",
  "La felicità e realizzazione di mia figlia Jennifer. \nSuperare il conflitto con una delle responsabili\nFar praticare un/a giovane e portarlo/a nel gruppo\nDaimoku per i 4 angoli della terra\nGrazie \nChe il mio compagno possa riabbracciare sua figlia",
  "1)Capire perché bisogna sempre vincere .... a me piace solo vivere e lasciar vivere\n2) Le mie azioni siano tali da poter agevolare chi ha desiderio di praticare questo buddismo ",
  "Voglio sconfiggere il cancro e voglio cambiare il karma familiare.",
  "Vincere sulla sfiducia, affrontare con coraggio le difficoltà della mia vita per Kosen rufu. Attrverso il mio cambiamento  far praticare ed incoraggiare quante più persone possibili. Dedicare il resto della mia vita alla propagazione del Gohonzon.",
  "Lavoro giusto per me ",
  "Iniziare veramente a trasformare le mie tendenze karmiche e a percepire la condizione attuale come la migliore per il mio sviluppo. Percepire attraverso il daimoku mio padre, che non c'è più e creare uno stato vitale tale da ispirare gli altri con le mie azioni. ",
  "Riuscire ad incoraggiare mia madre a iniziare a praticare",
  "Desidero che mia figlia cominci a praticare, perché acquisti fiducia in sé stessa, e speranza e forza per la sua vita",
  "Realizzare una famiglia armoniosa in cui tutti siano felici per kosen rufu e sentirmi me stessa",
  "L'esperienza di un intervento superato al massimo della determinazione e anche il lavoro con il cambiamento del karma personale. Realizzazione degli obiettivi del gruppo positano.",
  "Tre gruppi con due giovani ogni gruppo e due nuove persone ogni meeting, lavoro a tempo indeterminato, legami di fiducia con i miei figli.",
  "Realizzazione di tutti i miei scopi personali come prova concreta per lo sviluppo di kosen rufu ",
  "Pubblicare il mio ultimo libro con la Salani",
  "Tornare insieme alla donna che amo",
  "Realizzare una prova concreta per questo Corso che sia di incoraggiamento per i nuovi membri",
  "Famiglia armoniosa ,avere la possibilità di stare vicino alla mia famiglia,x kosen rufu",
  "Realizzare profondamente tutti i miei sogni senza mai mettere più da parte la mia felicità per rendere orgoglioso il mio maestro",
  "Un posto di lavoro di grande responsabilità dove poter fare shakobuku e propagare la legge",
  "Superare le difficoltà  rispetto ai lavoro ed economico la felicità  familiare felicità di ogni singolo  membro  e realizzano i loro obiettivi e dare prova concreta  per condividere  con tutti shakubuku 🙏🙏🚂",
  "Conoscere la figlia del mio compagno e creare insieme un ambiente familiare allargato pieno di gioia, rispetto, serenità e armonia.",
  "Sentire che il cuore di tutti noi,e' in sintonia con il cuore di Sensei Ikeda",
  "Comprare l'auto per Kosen-Rufu!!",
  "Entro la data del corso, far emergere il terzo gruppo sul territorio agropolese (SA) Italy",
  "Indipendenza",
];

const randomOrderGoals = goals
  .map((value) => ({ value, sort: Math.random() }))
  .sort((a, b) => a.sort - b.sort)
  .map(({ value }) => value);
---

<Layout title="Obiettivi" activeNav="/obiettivi">
  <main class="mb-5">
    <Goals />

    <hr class="my-5" />
    <section class="container my-4" id="obiettivi-membri">
      <div
        class="d-flex justify-content-center align-items-center flex-column text-center"
      >
        <h2 class="mb-5">Obiettivi dei membri</h2>

        <button class="btn btn-primary" id="shuffle"> Rimescola </button>
      </div>
    </section>

    <section
      class="d-flex flex-wrap container my-4"
      id="obiettivi-membri-shuffle"
    >
      {
        randomOrderGoals.map((goal) => (
          <div class="card m-4">
            <div class="card-header">Obiettivo</div>
            <div class="card-body">
              <blockquote class="blockquote mb-0">{goal}</blockquote>
            </div>
          </div>
        ))
      }
    </section>
  </main>

  <script>
    function shuffle() {
      var container = document.getElementById("obiettivi-membri-shuffle");
      var elementsArray = Array.prototype.slice.call(
        container.getElementsByClassName("card"),
      );
      elementsArray.forEach(function (element) {
        container.removeChild(element);
      });
      shuffleArray(elementsArray);
      elementsArray.forEach(function (element) {
        container.appendChild(element);
      });
    }

    function shuffleArray(array) {
      for (var i = array.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var temp = array[i];
        array[i] = array[j];
        array[j] = temp;
      }
      return array;
    }

    document.querySelector("#shuffle").addEventListener("click", () => {
      shuffle();
    });
  </script>
</Layout>
