---
import Layout from "../../layouts/Layout.astro";
import ArticleHeader from "../../components/ArticleHeader.astro";
import ArticleFooter from "../../components/ArticleFooter.astro";
import { getArticle } from "../../data/articles";

const article = getArticle("loris-andrea-giardini");

if (!article) {
  return Astro.redirect("/articoli");
}
---

<Layout
  title={`${article.title} · Corso Salerno 2026`}
  activeNav="/articoli"
  description="Video incoraggiamento di Loris Andrea Giardini."
>
  <main class="page">
    <ArticleHeader article={article} />

    <article class="article-body">
      <p class="article-intro">
        Condividiamo un video incoraggiamento di Andrea Giardini 'Loris' per il Corso Autunnale del Territorio Salerno 2026.
      </p>

      <figure class="article-figure article-figure--video">
        <video
          controls
          playsinline
          preload="metadata"
          poster="/video/loris-andrea-giardini-thumb.jpg"
          width={1000}
          height={1734}
        >
          <source
            src="/video/loris-andrea-giardini.mp4"
            type="video/mp4"
          />
          Il tuo browser non supporta la riproduzione video.
        </video>
      </figure>

      <p>
        Questo materiale può accompagnare lo studio per il corso in
        preparazione al Corso Autunnale del Territorio Salerno 2026. Trovi
        altri materiali nella pagina <a href="/info">Informazioni</a>.
      </p>

      <div class="firma">
        <p>
          <strong>Redazione Corso Salerno 2026</strong>
        </p>
      </div>

      <div class="end-mark">
        <span></span><span></span><span></span>
      </div>
    </article>

    <ArticleFooter />
  </main>
</Layout>