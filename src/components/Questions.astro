<section class="container my-4">
  <div class="d-flex justify-content-center flex-column text-center">
    <h2>Domande? Idee?</h2>
    <p>
      Condividi con noi domande e idee che terremo in forte considerazione per
      l'organizzazioen del corso!
    </p>

    <form id="formQuestions">
      <textarea
        class="form-control mx-auto my-4"
        id="questions"
        placeholder="Portare una grande esperienza al gruppo..."></textarea>

      <button class="btn btn-primary" type="submit" id="question-button">Invia</button>
      <p id="question-feedback" style="display: none;"></p>
    </form>
  </div>
</section>

<style>
  #questions {
    max-width: 600px;
  }
</style>


<script>
  // Funzione per inviare l'obiettivo

  const form = document.getElementById('formQuestions')
  const submitButton = document.getElementById('question-button')

  form.addEventListener('submit', function(event) {
    event.preventDefault();
    
    const question = (document.getElementById('questions') as HTMLTextAreaElement).value
    const feedbackElement = document.getElementById('question-feedback')

    submitButton.setAttribute('disabled', 'true')

    feedbackElement.style.display = 'none'
    fetch("/api/questions", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({ question })
    })
    .then(response => {
      if (!response.ok) {
        throw new Error("Errore durante l'invio della domanda.");
      }
      return response.json();
    })
    .then(data => {
      console.log(data.message);
      feedbackElement.innerText = "Domanda inviato con successo."
      feedbackElement.style.display = 'block'
    })
    .catch(error => {
      console.error("Errore durante l'invio della domanda:", error);
      feedbackElement.innerText = "Errore durante l'invio della domanda."
      feedbackElement.style.display = 'block'
    }).finally(() => {
      submitButton.removeAttribute('disabled')
    });
  });

