---
import { course2026 } from "../data/course2026";
import { getWaitlistMailto } from "../lib/waitlist";

const waitlistMailto = getWaitlistMailto();
---

<dialog id="waitlist-dialog" class="waitlist-dialog" aria-labelledby="waitlist-dialog-title">
  <div class="waitlist-dialog-content">
    <div class="waitlist-dialog-header">
      <h2 id="waitlist-dialog-title" class="waitlist-dialog-title">Lista d'attesa</h2>
      <button
        type="button"
        class="waitlist-dialog-dismiss"
        data-waitlist-close
        aria-label="Chiudi"
      >
        ×
      </button>
    </div>
    <p class="waitlist-dialog-lead">
      Qualora qualcuno avesse desiderio di partecipare al corso può richiedere di
      essere inserito in lista d'attesa inviando una mail a
      <strong>{course2026.waitlist.email}</strong>, specificando:
    </p>
    <ul class="waitlist-dialog-fields">
      {
        course2026.waitlist.requiredFields.map((field) => (
          <li>{field}</li>
        ))
      }
    </ul>
    <div class="waitlist-dialog-actions">
      <a href={waitlistMailto} class="cta-button waitlist-dialog-submit">
        Invia email
      </a>
      <button type="button" class="waitlist-dialog-close" data-waitlist-close>
        Chiudi
      </button>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById("waitlist-dialog") as HTMLDialogElement | null;

  function openWaitlistDialog() {
    dialog?.showModal();
  }

  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;

    if (target?.closest("[data-waitlist-close]")) {
      dialog?.close();
      return;
    }

    const trigger = target?.closest("[data-waitlist-open]");
    if (!trigger) return;

    event.preventDefault();
    openWaitlistDialog();
  });

  if (window.location.hash === "#lista-attesa") {
    openWaitlistDialog();
  }
</script>

<style>
  .waitlist-dialog {
    border: none;
    border-radius: var(--radius-md);
    padding: 0;
    max-width: 28rem;
    width: min(28rem, calc(100vw - 2rem));
    max-height: min(90dvh, 640px);
    overflow-y: auto;
    box-shadow: var(--shadow-md);
    margin: 0;
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 200;
  }

  .waitlist-dialog::backdrop {
    background: rgba(26, 16, 51, 0.5);
    backdrop-filter: blur(4px);
  }

  .waitlist-dialog-content {
    padding: 1.75rem;
  }

  .waitlist-dialog-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .waitlist-dialog-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--viola-dark);
    margin: 0;
    padding-right: 0.25rem;
    line-height: 1.3;
  }

  .waitlist-dialog-dismiss {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin: -0.15rem -0.15rem 0 0;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--testo-light);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .waitlist-dialog-dismiss:hover {
    background: rgba(124, 63, 168, 0.1);
    color: var(--viola);
  }

  .waitlist-dialog-dismiss:focus-visible {
    outline: 2px solid var(--viola);
    outline-offset: 2px;
  }

  .waitlist-dialog-lead {
    font-size: 0.97rem;
    line-height: 1.65;
    color: var(--testo);
    margin-bottom: 1rem;
  }

  .waitlist-dialog-lead strong {
    color: var(--viola-dark);
    word-break: break-all;
  }

  .waitlist-dialog-fields {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-bottom: 1rem;
  }

  .waitlist-dialog-fields li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--testo);
  }

  .waitlist-dialog-fields li::before {
    content: "→";
    color: var(--viola);
    font-weight: 700;
    flex-shrink: 0;
  }

  .waitlist-dialog-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .waitlist-dialog-submit {
    text-align: center;
  }

  .waitlist-dialog-close {
    width: 100%;
    padding: 0.75rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    color: var(--testo-light);
    transition: background 0.2s, border-color 0.2s;
  }

  .waitlist-dialog-close:hover {
    background: rgba(124, 63, 168, 0.06);
    border-color: rgba(124, 63, 168, 0.25);
    color: var(--viola);
  }
</style>
