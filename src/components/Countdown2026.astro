---
import { course2026 } from "../data/course2026";
---

<div class="countdown-wrapper">
  <p class="countdown-label">Mancano al corso</p>
  <div class="countdown" id="countdown">
    <div class="time-block">
      <span class="time-value" id="weeks">00</span>
      <span class="time-unit">Settimane</span>
    </div>
    <div class="time-block">
      <span class="time-value" id="days">00</span>
      <span class="time-unit">Giorni</span>
    </div>
    <div class="time-block">
      <span class="time-value" id="hours">00</span>
      <span class="time-unit">Ore</span>
    </div>
    <div class="time-block">
      <span class="time-value" id="minutes">00</span>
      <span class="time-unit">Minuti</span>
    </div>
  </div>
</div>

<script
  is:inline
  define:vars={{
    courseTimestamp: course2026.courseDate.getTime(),
  }}
>
  const MINUTES_IN_MS = 1000 * 60;
  const HOURS_IN_MS = 60 * MINUTES_IN_MS;
  const DAYS_IN_MS = 24 * HOURS_IN_MS;
  const WEEKS_IN_MS = DAYS_IN_MS * 7;

  function pad(n) {
    return n.toString().padStart(2, "0");
  }

  function updateCountDown() {
    const now = Date.now();
    const deltaTime = courseTimestamp - now;

    if (deltaTime <= 0) {
      document.querySelector("#weeks").textContent = "00";
      document.querySelector("#days").textContent = "00";
      document.querySelector("#hours").textContent = "00";
      document.querySelector("#minutes").textContent = "00";
      return;
    }

    const deltaWeeks = Math.trunc(deltaTime / WEEKS_IN_MS);
    const remainingDays = deltaTime % WEEKS_IN_MS;
    const deltaDays = Math.trunc(remainingDays / DAYS_IN_MS);
    const remainingHours = remainingDays % DAYS_IN_MS;
    const deltaHours = Math.trunc(remainingHours / HOURS_IN_MS);
    const remainingMinutes = remainingHours % HOURS_IN_MS;
    const deltaMinutes = Math.trunc(remainingMinutes / MINUTES_IN_MS);

    document.querySelector("#weeks").textContent = pad(deltaWeeks);
    document.querySelector("#days").textContent = pad(deltaDays);
    document.querySelector("#hours").textContent = pad(deltaHours);
    document.querySelector("#minutes").textContent = pad(deltaMinutes);
  }

  updateCountDown();
  setInterval(updateCountDown, 1000 * 60);
</script>

<style>
  .countdown-wrapper {
    text-align: center;
  }

  .countdown-label {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .countdown {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .time-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 4.5rem;
    padding: 1rem 0.75rem;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
  }

  .time-value {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .time-unit {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-muted);
    margin-top: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (min-width: 768px) {
    .countdown {
      gap: 1.25rem;
    }

    .time-block {
      min-width: 6rem;
      padding: 1.25rem 1rem;
    }

    .time-value {
      font-size: 3rem;
    }

    .time-unit {
      font-size: 0.8rem;
    }
  }
</style>
